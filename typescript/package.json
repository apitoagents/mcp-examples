{
  "name": "@apitoagents/sample-shop-mcp",
  "version": "1.0.1",
  "description": "MCP server exposing a sample shop API to ChatGPT, Claude and other agents: paginated search, idempotent orders, guarded cancellation. Official TypeScript SDK.",
  "mcpName": "io.github.apitoagents/sample-shop-mcp",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sample-shop-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "sample-api",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apitoagents/mcp-examples.git",
    "directory": "typescript"
  },
  "homepage": "https://apitoagents.com/docs/build-mcp-server-typescript",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "streamable-http",
    "ecommerce",
    "example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-sample-api.mjs",
    "start": "node dist/server.js",
    "stdio": "node dist/cli.js",
    "dev": "node --experimental-strip-types src/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
