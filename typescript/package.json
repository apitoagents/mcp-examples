{
  "name": "sample-shop-mcp-typescript",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing the Sample Shop API to AI agents over Streamable HTTP, written with the official TypeScript SDK.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node --experimental-strip-types src/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
